{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@fluxpipe/shared-types": ["packages/shared-types/src"],
      "@fluxpipe/shared-types/*": ["packages/shared-types/src/*"],
      "@fluxpipe/shared-utils": ["packages/shared-utils/src"],
      "@fluxpipe/shared-utils/*": ["packages/shared-utils/src/*"],
      "@fluxpipe/shared-config": ["packages/shared-config/src"],
      "@fluxpipe/shared-config/*": ["packages/shared-config/src/*"],
      "@fluxpipe/logger": ["packages/logger/src"],
      "@fluxpipe/logger/*": ["packages/logger/src/*"],
      "@fluxpipe/auth": ["packages/auth/src"],
      "@fluxpipe/auth/*": ["packages/auth/src/*"],
      "@fluxpipe/database": ["packages/database/src"],
      "@fluxpipe/database/*": ["packages/database/src/*"],
      "@fluxpipe/redis": ["packages/redis/src"],
      "@fluxpipe/redis/*": ["packages/redis/src/*"],
      "@fluxpipe/rabbitmq": ["packages/rabbitmq/src"],
      "@fluxpipe/rabbitmq/*": ["packages/rabbitmq/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
