NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://fluxpipe:fluxpipe_dev@postgres:5432/fluxpipe

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_URL=amqp://fluxpipe:fluxpipe_dev@rabbitmq:5672

# JWT
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-to-a-random-refresh-secret-32-chars-long

# Logging
LOG_LEVEL=debug

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@fluxpipe.io

# Encryption
ENCRYPTION_KEY=change-me-to-a-32-char-encryption-key-x
