{
  "name": "fluxpipe",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "jest -c tests/jest.config.ts --runInBand",
    "test:unit": "jest tests/unit -c tests/jest.config.ts --runInBand",
    "test:integration": "jest tests/integration -c tests/jest.config.ts --runInBand",
    "test:e2e": "jest tests/e2e -c tests/jest.config.ts --runInBand",
    "test:coverage": "jest -c tests/jest.config.ts --coverage",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\""
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.4.2",
    "express": "^4.19.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}
